<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="io.ringloom.samples.marketdatakv.sbe"
                   id="5201"
                   version="1"
                   semanticVersion="1.0.0"
                   description="RingLoom framework replicated KV market data sample"
                   headerType="messageHeader"
                   byteOrder="littleEndian">
    <types>
        <composite name="messageHeader" description="SBE message header">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
        <composite name="groupSizeEncoding" description="Repeating group dimensions">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup" primitiveType="uint16"/>
        </composite>
    </types>

    <sbe:message name="PriceSnapshot" id="4001" description="Latest price of one instrument (KV value)" blockLength="40">
        <field name="instrumentId" id="1" type="int64"/>
        <field name="bidNanos" id="2" type="int64"/>
        <field name="askNanos" id="3" type="int64"/>
        <field name="updateId" id="4" type="uint64"/>
        <field name="writerEpoch" id="5" type="uint64"/>
    </sbe:message>

    <sbe:message name="PriceRequest" id="4002" description="Price lookup request" blockLength="8">
        <field name="instrumentId" id="1" type="int64"/>
    </sbe:message>

    <sbe:message name="PriceResponse" id="4003" description="Price lookup response" blockLength="48">
        <field name="instrumentId" id="1" type="int64"/>
        <field name="bidNanos" id="2" type="int64"/>
        <field name="askNanos" id="3" type="int64"/>
        <field name="updateId" id="4" type="uint64"/>
        <field name="writerEpoch" id="5" type="uint64"/>
        <field name="status" id="6" type="int32"/>
    </sbe:message>
</sbe:messageSchema>
